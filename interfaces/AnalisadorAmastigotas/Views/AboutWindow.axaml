<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnalisadorAmastigotas.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="700"
        Width="1200"
        Height="700"
        x:Class="AnalisadorAmastigotas.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="L.U.M.A."
        WindowStartupLocation="CenterScreen">

    <!-- ============================================================ -->
    <!-- RECURSOS                                                     -->
    <!-- ============================================================ -->

    <Window.Resources>

        <!-- CORES -->

        <media:SolidColorBrush x:Key="GiemsaPurple"
                               Color="#7040A8"/>

        <media:SolidColorBrush x:Key="GiemsaPurpleDark"
                               Color="#4D277E"/>

        <media:SolidColorBrush x:Key="GiemsaPurpleHover"
                               Color="#542B86"/>

        <media:SolidColorBrush x:Key="GiemsaPink"
                               Color="#D95B8A"/>

        <media:SolidColorBrush x:Key="GiemsaPinkLight"
                               Color="#E982A6"/>

        <media:SolidColorBrush x:Key="BackgroundLight"
                               Color="#FBFAFD"/>

        <media:SolidColorBrush x:Key="SurfaceWhite"
                               Color="#FFFFFF"/>

        <media:SolidColorBrush x:Key="BorderSoft"
                               Color="#DED5E8"/>

        <media:SolidColorBrush x:Key="TextDark"
                               Color="#17131D"/>

        <media:SolidColorBrush x:Key="TextMuted"
                               Color="#3F3948"/>


        <!-- GRADIENTE PRINCIPAL -->

        <media:LinearGradientBrush x:Key="LumaGradient"
                                   StartPoint="0%,0%"
                                   EndPoint="100%,0%">

            <media:GradientStop Color="#E982A6"
                                Offset="0"/>

            <media:GradientStop Color="#C6538D"
                                Offset="0.24"/>

            <media:GradientStop Color="#8F4AA1"
                                Offset="0.48"/>

            <media:GradientStop Color="#7040A8"
                                Offset="0.70"/>

            <media:GradientStop Color="#5A2C96"
                                Offset="1"/>

        </media:LinearGradientBrush>


        <!-- GRADIENTE DA BARRA LATERAL -->

        <media:LinearGradientBrush x:Key="SidebarGradient"
                                   StartPoint="0%,100%"
                                   EndPoint="100%,0%">

            <media:GradientStop Color="#D45A8A"
                                Offset="0"/>

            <media:GradientStop Color="#944C9F"
                                Offset="0.30"/>

            <media:GradientStop Color="#7040A8"
                                Offset="0.62"/>

            <media:GradientStop Color="#5B2E97"
                                Offset="1"/>

        </media:LinearGradientBrush>


        <!-- GRADIENTE DOS BOTÕES -->

        <media:LinearGradientBrush x:Key="ButtonGradient"
                                   StartPoint="0%,0%"
                                   EndPoint="100%,100%">

            <media:GradientStop Color="#7040A8"
                                Offset="0"/>

            <media:GradientStop Color="#7542A9"
                                Offset="0.50"/>

            <media:GradientStop Color="#8147A5"
                                Offset="1"/>

        </media:LinearGradientBrush>


        <!-- HOVER -->

        <media:SolidColorBrush x:Key="ButtonHoverBrush"
                               Color="#D95B8A"/>


        <!-- PRESSIONADO -->

        <media:SolidColorBrush x:Key="ButtonPressedBrush"
                               Color="#C84C82"/>


        <!-- BORDA -->

        <media:LinearGradientBrush x:Key="ButtonBorderGradient"
                                   StartPoint="0%,0%"
                                   EndPoint="100%,100%">

            <media:GradientStop Color="#E982A6"
                                Offset="0"/>

            <media:GradientStop Color="#D95B8A"
                                Offset="0.55"/>

            <media:GradientStop Color="#C84C82"
                                Offset="1"/>

        </media:LinearGradientBrush>

    </Window.Resources>


    <!-- ============================================================ -->
    <!-- ESTILOS                                                      -->
    <!-- ============================================================ -->

    <Window.Styles>

        <!-- BOTÕES DA BARRA LATERAL -->

        <Style Selector="Button.sidebar-button">

            <Setter Property="Width"
                    Value="220"/>

            <Setter Property="Height"
                    Value="56"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource ButtonGradient}"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ButtonBorderGradient}"/>

            <Setter Property="BorderThickness"
                    Value="2"/>

            <Setter Property="CornerRadius"
                    Value="9"/>

            <Setter Property="Margin"
                    Value="0,0,0,14"/>

            <!-- IMPORTANTE:
                 o conteúdo passa a ocupar o botão todo -->

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <!-- espaço interno para o ícone não encostar na borda -->

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Opacity"
                    Value="1"/>

        </Style>


        <!-- HOVER -->

        <Style Selector="Button.sidebar-button:pointerover">

            <Setter Property="Background"
                    Value="{StaticResource ButtonHoverBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ButtonHoverBrush}"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

        </Style>


        <!-- PRESSIONADO -->

        <Style Selector="Button.sidebar-button:pressed">

            <Setter Property="Background"
                    Value="{StaticResource ButtonPressedBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ButtonPressedBrush}"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

        </Style>


        <!-- DESABILITADO -->

        <Style Selector="Button.sidebar-button:disabled">

            <Setter Property="Opacity"
                    Value="1"/>

        </Style>

    </Window.Styles>


    <!-- ============================================================ -->
    <!-- INTERFACE                                                    -->
    <!-- ============================================================ -->

    <Grid>


        <!-- ======================================================== -->
        <!-- FUNDO                                                    -->
        <!-- ======================================================== -->

        <Border Background="{StaticResource BackgroundLight}"/>


        <!-- IMAGEM MICROSCÓPICA DO FUNDO -->

        <Image Source="/Assets/giemsa ficticia.jpg"
               Stretch="UniformToFill"
               Opacity="0.075"/>


        <!-- ======================================================== -->
        <!-- ESTRUTURA PRINCIPAL                                      -->
        <!-- ======================================================== -->

        <Grid ColumnDefinitions="260,*">


            <!-- ==================================================== -->
            <!-- BARRA LATERAL                                        -->
            <!-- ==================================================== -->

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarGradient}">

                <Grid RowDefinitions="*,Auto">


                    <!-- ============================================ -->
                    <!-- BOTÕES                                       -->
                    <!-- ============================================ -->

                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Top"
                                Margin="20,32,20,20">


                        <!-- ======================================== -->
                        <!-- NOVA CONSULTA                            -->
                        <!-- ======================================== -->

                        <Button Classes="sidebar-button"
                                Click="NovaConsulta_Click">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Spacing="14">

                                <Image Source="/Assets/nova branco.png"
                                       Width="28"
                                       Height="28"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Text="NOVA CONSULTA"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>

                            </StackPanel>

                        </Button>


                        <!-- ======================================== -->
                        <!-- OPÇÕES                                   -->
                        <!-- ======================================== -->

                        <Button Classes="sidebar-button"
                                Click="Opcoes_Click">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Spacing="14">

                                <Image Source="/Assets/opcoes branco.png"
                                       Width="28"
                                       Height="28"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Text="OPÇÕES"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>

                            </StackPanel>

                        </Button>


                        <!-- ======================================== -->
                        <!-- SOBRE                                    -->
                        <!-- ======================================== -->

                        <Button Classes="sidebar-button"
                                Click="Sobre_Click">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Spacing="14">

                                <Image Source="/Assets/sobre branco.png"
                                       Width="28"
                                       Height="28"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Text="SOBRE"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>

                            </StackPanel>

                        </Button>


                        <!-- ======================================== -->
                        <!-- SAIR                                     -->
                        <!-- ======================================== -->

                        <Button Classes="sidebar-button"
                                Margin="0"
                                Click="Sair_Click">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Spacing="14">

                                <Image Source="/Assets/sair branco.png"
                                       Width="28"
                                       Height="28"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Text="SAIR"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>


                    <!-- ============================================ -->
                    <!-- IDENTIDADE INSTITUCIONAL                     -->
                    <!-- ============================================ -->

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14"
                                Margin="15,10,15,22">

                        <Image Source="/Assets/logo GIM ficticia.png"
                               Width="150"
                               Height="110"
                               Stretch="Uniform"/>

                        <Image Source="/Assets/UFU.png"
                               Width="110"
                               Height="80"
                               Stretch="Uniform"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ==================================================== -->
            <!-- ÁREA CENTRAL                                         -->
            <!-- ==================================================== -->

            <Grid Grid.Column="1"
                  Background="Transparent">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">


                    <!-- ============================================ -->
                    <!-- TÍTULO                                       -->
                    <!-- ============================================ -->

                    <StackPanel HorizontalAlignment="Center"
                                Spacing="2">

                        <TextBlock Text="L.U.M.A."
                                   HorizontalAlignment="Center"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   LetterSpacing="2"
                                   Foreground="{StaticResource LumaGradient}"/>

                        <TextBlock Text="Labeled Unicellular &amp; Microbe Analysis"
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   LetterSpacing="1"
                                   Foreground="{StaticResource TextDark}"/>

                    </StackPanel>


                    <!-- ESPAÇO -->

                    <Border Height="18"/>


                    <!-- ============================================ -->
                    <!-- CARD DA LOGO                                 -->
                    <!-- ============================================ -->

                    <Border Width="560"
                            Height="390"
                            Background="#FEFDFE"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="30"
                            BoxShadow="0 7 24 0 #35000000">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">

                            <Image Source="/Assets/logo LUMA ficticia.png"
                                   Width="300"
                                   Height="240"
                                   HorizontalAlignment="Center"
                                   Stretch="Uniform"/>

                            <TextBlock Text="MICROSCOPIC IMAGE ANALYSIS"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       LetterSpacing="2"
                                       Foreground="{StaticResource LumaGradient}"/>

                        </StackPanel>

                    </Border>


                    <!-- ESPAÇO -->

                    <Border Height="14"/>


                    <!-- ============================================ -->
                    <!-- BOAS-VINDAS                                  -->
                    <!-- ============================================ -->

                    <TextBlock Text="Bem-vindo ao L.U.M.A."
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               LetterSpacing="0.5"
                               Foreground="{StaticResource TextDark}"/>


                    <!-- ============================================ -->
                    <!-- DESCRIÇÃO                                    -->
                    <!-- ============================================ -->

                    <TextBlock Text="Sistema de análise e identificação de imagens microscópicas."
                               HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextDark}"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>