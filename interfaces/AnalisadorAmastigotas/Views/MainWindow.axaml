<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnalisadorAmastigotas.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="700"
        Width="1200"
        Height="700"
        x:Class="AnalisadorAmastigotas.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="L.U.M.A."
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- CORES PRINCIPAIS -->
        <!-- ===================================================== -->

        <media:SolidColorBrush x:Key="SidebarPurple"
                               Color="#4E2E91"/>

        <media:SolidColorBrush x:Key="ButtonPurple"
                               Color="#6A4CB3"/>

        <media:SolidColorBrush x:Key="ButtonPurpleHover"
                               Color="#7A5BC0"/>

        <media:SolidColorBrush x:Key="ButtonPurplePressed"
                               Color="#5B3FA4"/>

        <media:SolidColorBrush x:Key="AccentPink"
                               Color="#E56A9B"/>

        <media:SolidColorBrush x:Key="BackgroundLight"
                               Color="#F7F4FA"/>

        <media:SolidColorBrush x:Key="SurfaceWhite"
                               Color="#FFFFFF"/>

        <media:SolidColorBrush x:Key="BorderSoft"
                               Color="#E3DCEF"/>

        <media:SolidColorBrush x:Key="TextDark"
                               Color="#231A33"/>

        <media:SolidColorBrush x:Key="TextMuted"
                               Color="#5E5770"/>

        <media:SolidColorBrush x:Key="TitlePurple"
                               Color="#6B43AE"/>

        <media:SolidColorBrush x:Key="CardLine"
                               Color="#E8E0F0"/>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- ESTILOS -->
    <!-- ========================================================= -->

    <Window.Styles>

        <!-- BOTÕES DA LATERAL -->

        <Style Selector="Button.sidebar-button">

            <Setter Property="Width"
                    Value="220"/>

            <Setter Property="Height"
                    Value="56"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource ButtonPurple}"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Margin"
                    Value="0,0,0,14"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="0"/>

        </Style>


        <!-- HOVER -->

        <Style Selector="Button.sidebar-button:pointerover">

            <Setter Property="Background"
                    Value="{StaticResource ButtonPurpleHover}"/>

        </Style>


        <!-- PRESSIONADO -->

        <Style Selector="Button.sidebar-button:pressed">

            <Setter Property="Background"
                    Value="{StaticResource ButtonPurplePressed}"/>

        </Style>


        <!-- ÍCONES -->

        <Style Selector="Image.sidebar-icon-white">

            <Setter Property="IsVisible"
                    Value="True"/>

        </Style>

        <Style Selector="Image.sidebar-icon-hover">

            <Setter Property="IsVisible"
                    Value="False"/>

        </Style>

    </Window.Styles>


    <!-- ========================================================= -->
    <!-- INTERFACE -->
    <!-- ========================================================= -->

    <Grid>

        <!-- FUNDO GERAL -->

        <Border Background="{StaticResource BackgroundLight}"/>


        <!-- FUNDO MICROSCÓPICO BEM SUAVE -->

        <Image Source="/Assets/giemsa ficticia.jpg"
               Stretch="UniformToFill"
               Opacity="0.045"/>


        <!-- ESTRUTURA PRINCIPAL -->

        <Grid ColumnDefinitions="260,*">


            <!-- ===================================================== -->
            <!-- BARRA LATERAL -->
            <!-- ===================================================== -->

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarPurple}">

                <Grid RowDefinitions="*,Auto">


                    <!-- BOTÕES -->

                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Top"
                                Margin="20,32,20,20">


                        <!-- NOVA CONSULTA -->

                        <Button Classes="sidebar-button"
                                Click="NovaConsulta_Click">

                            <Grid ColumnDefinitions="30,*"
                                  Margin="14,0,10,0"
                                  VerticalAlignment="Center">

                                <Image Grid.Column="0"
                                       Classes="sidebar-icon-white"
                                       Source="/Assets/nova branco.png"
                                       Width="27"
                                       Height="27"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Grid.Column="1"
                                           Text="NOVA CONSULTA"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           TextWrapping="NoWrap"/>

                            </Grid>

                        </Button>


                        <!-- OPÇÕES -->

                        <Button Classes="sidebar-button"
                                Click="Opcoes_Click">

                            <Grid ColumnDefinitions="30,*"
                                  Margin="14,0,10,0"
                                  VerticalAlignment="Center">

                                <Image Grid.Column="0"
                                       Classes="sidebar-icon-white"
                                       Source="/Assets/opcoes branco.png"
                                       Width="27"
                                       Height="27"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Grid.Column="1"
                                           Text="OPÇÕES"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           TextWrapping="NoWrap"/>

                            </Grid>

                        </Button>


                        <!-- SOBRE -->

                        <Button Classes="sidebar-button"
                                Click="Sobre_Click">

                            <Grid ColumnDefinitions="30,*"
                                  Margin="14,0,10,0"
                                  VerticalAlignment="Center">

                                <Image Grid.Column="0"
                                       Classes="sidebar-icon-white"
                                       Source="/Assets/sobre branco.png"
                                       Width="27"
                                       Height="27"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Grid.Column="1"
                                           Text="SOBRE"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           TextWrapping="NoWrap"/>

                            </Grid>

                        </Button>


                        <!-- SAIR -->

                        <Button Classes="sidebar-button"
                                Margin="0"
                                Click="Sair_Click">

                            <Grid ColumnDefinitions="30,*"
                                  Margin="14,0,10,0"
                                  VerticalAlignment="Center">

                                <Image Grid.Column="0"
                                       Classes="sidebar-icon-white"
                                       Source="/Assets/sair branco.png"
                                       Width="27"
                                       Height="27"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Grid.Column="1"
                                           Text="SAIR"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           TextWrapping="NoWrap"/>

                            </Grid>

                        </Button>

                    </StackPanel>


                    <!-- LOGO GIM -->

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="15,10,15,24">

                        <Image Source="/Assets/logo GIM ficticia.png"
                               Width="145"
                               Height="145"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ===================================================== -->
            <!-- ÁREA CENTRAL -->
            <!-- ===================================================== -->

            <Grid Grid.Column="1"
                  Background="Transparent">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">


                    <!-- TÍTULO -->

                    <StackPanel HorizontalAlignment="Center"
                                Spacing="2">

                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   LetterSpacing="2">

                            <Run Text="L"
                                 Foreground="{StaticResource TitlePurple}"/>

                            <Run Text="."
                                 Foreground="{StaticResource AccentPink}"/>

                            <Run Text="U"
                                 Foreground="{StaticResource TitlePurple}"/>

                            <Run Text="."
                                 Foreground="{StaticResource AccentPink}"/>

                            <Run Text="M"
                                 Foreground="{StaticResource TitlePurple}"/>

                            <Run Text="."
                                 Foreground="{StaticResource AccentPink}"/>

                            <Run Text="A"
                                 Foreground="{StaticResource TitlePurple}"/>

                            <Run Text="."
                                 Foreground="{StaticResource AccentPink}"/>

                        </TextBlock>

                        <TextBlock Text="Labeled Unicellular &amp; Microbe Analysis"
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   LetterSpacing="0.8"
                                   Foreground="{StaticResource TextMuted}"/>

                    </StackPanel>


                    <!-- ESPAÇO -->

                    <Border Height="18"/>


                    <!-- CARD CENTRAL -->

                    <Border Width="560"
                            Height="390"
                            Background="{StaticResource SurfaceWhite}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="30"
                            BoxShadow="0 8 24 0 #22000000">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">

                            <Image Source="/Assets/logo LUMA ficticia.png"
                                   Width="300"
                                   Height="220"
                                   HorizontalAlignment="Center"
                                   Stretch="Uniform"/>

                            <TextBlock Text="MICROSCOPIC IMAGE ANALYSIS"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       LetterSpacing="2"
                                       Foreground="{StaticResource AccentPink}"/>

                        </StackPanel>

                    </Border>


                    <!-- ESPAÇO -->

                    <Border Height="16"/>


                    <!-- BOAS-VINDAS -->

                    <TextBlock Text="Bem-vindo ao L.U.M.A."
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TitlePurple}"/>


                    <!-- DESCRIÇÃO -->

                    <TextBlock Text="Sistema de análise e identificação de imagens microscópicas."
                               HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextMuted}"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>