<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnalisadorAmastigotas.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="700"
        Width="1200"
        Height="700"
        x:Class="AnalisadorAmastigotas.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="L.U.M.A."
        Icon="/Assets/logo LUMA ficticia.png"
        WindowStartupLocation="CenterScreen">

    <!-- ========================================================= -->
    <!-- CORES                                                     -->
    <!-- ========================================================= -->

    <Window.Resources>

        <!-- Roxo oficial da logo -->
        <media:SolidColorBrush x:Key="LumaPurple"
                               Color="#644899"/>

        <!-- Botões -->
        <media:SolidColorBrush x:Key="ButtonPurple"
                               Color="#7559AB"/>

        <media:SolidColorBrush x:Key="ButtonPurpleHover"
                               Color="#876CC0"/>

        <media:SolidColorBrush x:Key="ButtonPurplePressed"
                               Color="#523B7E"/>

        <!-- Rosa de destaque -->
        <media:SolidColorBrush x:Key="AccentPink"
                               Color="#E56A9B"/>

        <!-- Cores neutras -->
        <media:SolidColorBrush x:Key="BackgroundLight"
                               Color="#F7F4FA"/>

        <media:SolidColorBrush x:Key="SurfaceWhite"
                               Color="#FFFFFF"/>

        <media:SolidColorBrush x:Key="BorderSoft"
                               Color="#E3DCEF"/>

        <media:SolidColorBrush x:Key="TextDark"
                               Color="#231A33"/>

        <media:SolidColorBrush x:Key="TextMuted"
                               Color="#5E5770"/>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <Window.Styles>

        <!-- BOTÕES DA BARRA LATERAL -->

        <Style Selector="Button.sidebar-button">

            <Setter Property="Width"
                    Value="220"/>

            <Setter Property="Height"
                    Value="56"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource ButtonPurple}"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Margin"
                    Value="0,0,0,14"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Opacity"
                    Value="1"/>

        </Style>


        <!-- HOVER -->

        <Style Selector="Button.sidebar-button:pointerover">

            <Setter Property="Background"
                    Value="{StaticResource ButtonPurpleHover}"/>

        </Style>


        <!-- PRESSIONADO -->

        <Style Selector="Button.sidebar-button:pressed">

            <Setter Property="Background"
                    Value="{StaticResource ButtonPurplePressed}"/>

        </Style>

    </Window.Styles>


    <!-- ========================================================= -->
    <!-- INTERFACE                                                 -->
    <!-- ========================================================= -->

    <Grid>

        <!-- FUNDO -->

        <Border Background="{StaticResource BackgroundLight}"/>


        <!-- IMAGEM MICROSCÓPICA DE FUNDO -->

        <Image Source="/Assets/giemsa ficticia.png"
               Stretch="UniformToFill"
               Opacity="0.295"/>


        <!-- ESTRUTURA PRINCIPAL -->

        <Grid ColumnDefinitions="260,*">


            <!-- ================================================= -->
            <!-- BARRA LATERAL                                     -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="{StaticResource LumaPurple}"
                    Opacity="1">

                <Grid RowDefinitions="*,Auto">


                    <!-- BOTÕES -->

                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Top"
                                Margin="20,32,20,20">


                        <!-- NOVA ANÁLISE -->

                        <Button Classes="sidebar-button"
                                Click="NovaConsulta_Click">

                            <Grid ColumnDefinitions="30,*"
                                  Margin="14,0,10,0"
                                  VerticalAlignment="Center">

                                <Image Grid.Column="0"
                                       Source="/Assets/nova branco.png"
                                       Width="27"
                                       Height="27"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Grid.Column="1"
                                           Text="NEW ANALYSIS"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           TextWrapping="NoWrap"/>

                            </Grid>

                        </Button>


                        <!-- OPÇÕES -->

                        <Button Classes="sidebar-button"
                                Click="Opcoes_Click">

                            <Grid ColumnDefinitions="30,*"
                                  Margin="14,0,10,0"
                                  VerticalAlignment="Center">

                                <Image Grid.Column="0"
                                       Source="/Assets/opcoes branco.png"
                                       Width="27"
                                       Height="27"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Grid.Column="1"
                                           Text="OPTIONS"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           TextWrapping="NoWrap"/>

                            </Grid>

                        </Button>


                        <!-- SOBRE -->

                        <Button Classes="sidebar-button"
                                Click="Sobre_Click">

                            <Grid ColumnDefinitions="30,*"
                                  Margin="14,0,10,0"
                                  VerticalAlignment="Center">

                                <Image Grid.Column="0"
                                       Source="/Assets/sobre branco.png"
                                       Width="27"
                                       Height="27"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Grid.Column="1"
                                           Text="ABOUT"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           TextWrapping="NoWrap"/>

                            </Grid>

                        </Button>


                        <!-- SAIR -->

                        <Button Classes="sidebar-button"
                                Margin="0"
                                Click="Sair_Click">

                            <Grid ColumnDefinitions="30,*"
                                  Margin="14,0,10,0"
                                  VerticalAlignment="Center">

                                <Image Grid.Column="0"
                                       Source="/Assets/sair branco.png"
                                       Width="27"
                                       Height="27"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>

                                <TextBlock Grid.Column="1"
                                           Text="EXIT"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           TextWrapping="NoWrap"/>

                            </Grid>

                        </Button>

                    </StackPanel>


                    <!-- LOGO GIM -->

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="15,10,15,24">

                        <Image Source="/Assets/logo GIM ficticia.png"
                               Width="145"
                               Height="145"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- ÁREA PRINCIPAL                                    -->
            <!-- ================================================= -->

            <Grid Grid.Column="1"
                  Background="Transparent">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">


                    <!-- ========================================= -->
                    <!-- TÍTULO L.U.M.A.                           -->
                    <!-- ========================================= -->

                    <StackPanel HorizontalAlignment="Center"
                                Spacing="2">

                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   LetterSpacing="2">

                            <Run Text="L"
                                 Foreground="{StaticResource LumaPurple}"/>

                            <Run Text="."
                                 Foreground="{StaticResource AccentPink}"/>

                            <Run Text="U"
                                 Foreground="{StaticResource LumaPurple}"/>

                            <Run Text="."
                                 Foreground="{StaticResource AccentPink}"/>

                            <Run Text="M"
                                 Foreground="{StaticResource LumaPurple}"/>

                            <Run Text="."
                                 Foreground="{StaticResource AccentPink}"/>

                            <Run Text="A"
                                 Foreground="{StaticResource LumaPurple}"/>

                            <Run Text="."
                                 Foreground="{StaticResource AccentPink}"/>

                        </TextBlock>


                        <TextBlock Text="Labeled Unicellular &amp; Microbe Analysis"
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   LetterSpacing="0.8"
                                   Foreground="{StaticResource TextMuted}"/>

                    </StackPanel>


                    <Border Height="18"/>


                    <!-- ========================================= -->
                    <!-- CARD CENTRAL                              -->
                    <!-- ========================================= -->

                    <Border Width="500"
                            Height="350"
                            Background="{StaticResource SurfaceWhite}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="26"
                            BoxShadow="0 8 24 0 #22000000">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">

                            <!-- LOGO -->

                            <Image Source="/Assets/logo LUMA ficticia.png"
                                   Width="220"
                                   Height="170"
                                   HorizontalAlignment="Center"
                                   Stretch="Uniform"/>


                            <!-- BEM-VINDO -->

                            <TextBlock Text="Welcome to L.U.M.A."
                                       HorizontalAlignment="Center"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource LumaPurple}"
                                       Margin="0,4,0,0"/>


                            <!-- DESCRIÇÃO -->

                            <TextBlock Text="Microscopic image analysis and identification system."
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="380"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,4"/>


                            <!-- MICROSCOPIC -->

                            <TextBlock Text="MICROSCOPIC IMAGE ANALYSIS"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       LetterSpacing="2"
                                       Foreground="{StaticResource AccentPink}"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- pequeno respiro abaixo do card -->

                    <Border Height="10"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>