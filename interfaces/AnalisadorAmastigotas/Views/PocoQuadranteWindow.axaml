<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AnalisadorAmastigotas.Views.PocoQuadranteWindow"
    Title="L.U.M.A. - Poço e Quadrante"
    Icon="/Assets/logo LUMA ficticia.png"
    Width="1200"
    Height="700"
    WindowStartupLocation="CenterScreen"
    Background="#F8F6FA">

    <Window.Styles>

        <!-- ===================================================== -->
        <!-- ETAPAS LATERAIS                                      -->
        <!-- ===================================================== -->

        <Style Selector="Border.etapa">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E8E1EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="Border.etapa.ativa">

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Background">

                <LinearGradientBrush
                    StartPoint="0%,0%"
                    EndPoint="100%,0%">

                    <GradientStop Color="#644899" Offset="0"/>
                    <GradientStop Color="#644899" Offset="1"/>

                </LinearGradientBrush>

            </Setter>

        </Style>

        <Style Selector="Border.etapa.bloqueada">
            <Setter Property="Background" Value="#D9D6DC"/>
            <Setter Property="BorderBrush" Value="#D9D6DC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>


        <!-- ===================================================== -->
        <!-- BOTÕES DOS POÇOS                                     -->
        <!-- ===================================================== -->

        <Style Selector="Button.pocoButton">

            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="26"/>

            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#644899"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="Foreground" Value="#644899"/>

            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Padding" Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <Style Selector="Button.pocoButton:pointerover">

            <Setter Property="Background" Value="#F2EEFA"/>
            <Setter Property="BorderBrush" Value="#7559AB"/>

        </Style>


        <Style Selector="Button.pocoButton:pressed">

            <Setter Property="Background" Value="#E8E0F2"/>
            <Setter Property="BorderBrush" Value="#523B7E"/>

        </Style>


        <Style Selector="Button.pocoButton.selected">

            <Setter Property="Background" Value="#644899"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#644899"/>

        </Style>


        <!-- ===================================================== -->
        <!-- BOTÕES DOS QUADRANTES                                -->
        <!-- ===================================================== -->

        <Style Selector="Button.quadranteButton">

            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="88"/>

            <Setter Property="CornerRadius" Value="16"/>

            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DED4EA"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Foreground" Value="#644899"/>

            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <Style Selector="Button.quadranteButton:pointerover">

            <Setter Property="Background" Value="#F2EEFA"/>
            <Setter Property="BorderBrush" Value="#7559AB"/>

        </Style>


        <Style Selector="Button.quadranteButton:pressed">

            <Setter Property="Background" Value="#E8E0F2"/>
            <Setter Property="BorderBrush" Value="#523B7E"/>

        </Style>


        <Style Selector="Button.quadranteButton.selected">

            <Setter Property="Background" Value="#644899"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#644899"/>

        </Style>


        <!-- ===================================================== -->
        <!-- BOTÃO AVANÇAR                                        -->
        <!-- ===================================================== -->

        <Style Selector="Button.avancarButton">

            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="52"/>

            <Setter Property="CornerRadius" Value="10"/>

            <Setter Property="Background">

                <LinearGradientBrush
                    StartPoint="0%,0%"
                    EndPoint="100%,0%">

                    <GradientStop Color="#644899" Offset="0"/>
                    <GradientStop Color="#644899" Offset="1"/>

                </LinearGradientBrush>

            </Setter>

            <Setter Property="Foreground" Value="#FFFFFF"/>

            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <Style Selector="Button.avancarButton:disabled">

            <Setter Property="Background" Value="#D9D6DC"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Opacity" Value="1"/>

        </Style>


        <Style Selector="Button.avancarButton:pointerover:enabled">

            <Setter Property="Background" Value="#7559AB"/>

        </Style>


        <Style Selector="Button.avancarButton:pressed:enabled">

            <Setter Property="Background" Value="#523B7E"/>

        </Style>

    </Window.Styles>


    <!-- ========================================================= -->
    <!-- TELA                                                      -->
    <!-- ========================================================= -->

    <Grid Background="#F8F6FA">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="260"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- GABARITO LATERAL                                     -->
        <!-- ===================================================== -->

        <Border
            Grid.Column="0"
            Background="#EEEAF2"
            Padding="20">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <TextBlock
                    Grid.Row="0"
                    Text="GABARITO"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="#644899"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,20"/>


                <StackPanel
                    Grid.Row="1"
                    Spacing="10">


                    <!-- ================================================= -->
                    <!-- DOENÇA                                            -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="DoencaEtapaBorder"
                        Classes="etapa">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="40"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border
                                x:Name="DoencaIconBorder"
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="#644899"
                                HorizontalAlignment="Center">

                                <TextBlock
                                    x:Name="DoencaIconTextBlock"
                                    Text="✓"
                                    Foreground="White"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Spacing="2">

                                <TextBlock
                                    x:Name="DoencaTituloTextBlock"
                                    Text="DOENÇA"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#644899"/>

                                <TextBlock
                                    x:Name="DoencaTextBlock"
                                    Text="—"
                                    FontSize="13"
                                    Foreground="#6E667A"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- LINHAGEM                                          -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="LinhagemEtapaBorder"
                        Classes="etapa">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="40"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border
                                x:Name="LinhagemIconBorder"
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="#644899"
                                HorizontalAlignment="Center">

                                <TextBlock
                                    x:Name="LinhagemIconTextBlock"
                                    Text="✓"
                                    Foreground="White"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Spacing="2">

                                <TextBlock
                                    x:Name="LinhagemTituloTextBlock"
                                    Text="LINHAGEM"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#644899"/>

                                <TextBlock
                                    x:Name="LinhagemTextBlock"
                                    Text="—"
                                    FontSize="13"
                                    Foreground="#6E667A"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- LÂMINA                                            -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="LaminaEtapaBorder"
                        Classes="etapa">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="40"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border
                                x:Name="LaminaIconBorder"
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="#644899"
                                HorizontalAlignment="Center">

                                <TextBlock
                                    x:Name="LaminaIconTextBlock"
                                    Text="✓"
                                    Foreground="White"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Spacing="2">

                                <TextBlock
                                    x:Name="LaminaTituloTextBlock"
                                    Text="LÂMINA"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#644899"/>

                                <TextBlock
                                    x:Name="LaminaTextBlock"
                                    Text="—"
                                    FontSize="13"
                                    Foreground="#6E667A"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- POÇO                                              -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="PocoEtapaBorder"
                        Classes="etapa ativa">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="40"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border
                                x:Name="PocoIconBorder"
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="#FFFFFF"
                                HorizontalAlignment="Center">

                                <TextBlock
                                    x:Name="PocoIconTextBlock"
                                    Text="4"
                                    Foreground="#644899"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Spacing="2">

                                <TextBlock
                                    x:Name="PocoTituloTextBlock"
                                    Text="POÇO"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFF"/>

                                <TextBlock
                                    x:Name="PocoTextBlock"
                                    Text="Selecione o poço"
                                    FontSize="13"
                                    Foreground="#FFF7FC"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- QUADRANTE                                         -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="QuadranteEtapaBorder"
                        Classes="etapa bloqueada">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="40"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border
                                x:Name="QuadranteIconBorder"
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="#C9C5CC"
                                HorizontalAlignment="Center">

                                <TextBlock
                                    x:Name="QuadranteIconTextBlock"
                                    Text="5"
                                    Foreground="#777777"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Spacing="2">

                                <TextBlock
                                    x:Name="QuadranteTituloTextBlock"
                                    Text="QUADRANTE"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#777777"/>

                                <TextBlock
                                    x:Name="QuadranteTextBlock"
                                    Text="Bloqueado"
                                    FontSize="13"
                                    Foreground="#888888"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </StackPanel>


                <!-- DECORAÇÃO -->

                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Margin="8,20,0,0"
                    Opacity="0.45">

                    <TextBlock
                        Text="◦  ◦  ◦"
                        FontSize="22"
                        Foreground="#CDBCEB"/>

                    <TextBlock
                        Text="◦  ◦  ◦"
                        FontSize="22"
                        Foreground="#E5B9DB"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- ÁREA PRINCIPAL                                       -->
        <!-- ===================================================== -->

        <Grid
            Grid.Column="1"
            Margin="30,25,30,25">

            <!--
                EXATAMENTE METADE / METADE

                *   = POÇO
                1   = linha divisória
                *   = QUADRANTE
            -->

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="1"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- POÇO - ESQUERDA                                  -->
            <!-- ================================================= -->

            <Grid
                Grid.Column="0"
                Margin="0,0,24,0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- TÍTULO -->

                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Spacing="4">

                    <TextBlock
                        Text="POÇO"
                        FontSize="34"
                        FontWeight="Bold"
                        Foreground="#644899"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="Selecione o poço da lâmina"
                        FontSize="15"
                        Foreground="#6E667A"
                        HorizontalAlignment="Center"/>

                    <Border
                        Width="58"
                        Height="4"
                        CornerRadius="2"
                        Background="#D83D94"
                        HorizontalAlignment="Center"
                        Margin="0,7,0,0"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- LÂMINA EM PÉ + BOTÕES LATERAIS                  -->
                <!-- ================================================= -->

                <Grid
                    x:Name="PocosLayoutGrid"
                    Grid.Row="1"
                    Width="430"
                    Height="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>

                        <!-- BOTÕES ESQUERDA -->

                        <ColumnDefinition Width="70"/>

                        <!-- IMAGEM CENTRAL -->

                        <ColumnDefinition Width="290"/>

                        <!-- BOTÕES DIREITA -->

                        <ColumnDefinition Width="70"/>

                    </Grid.ColumnDefinitions>


                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ============================================= -->
                    <!-- IMAGEM EM PÉ                                  -->
                    <!-- ============================================= -->

                    <Grid
                        Grid.Column="1"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Width="255"
                        Height="460"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ClipToBounds="False">

                        <!-- LÂMINA 1 -->
                        <Image
                            x:Name="Lamina1VisualImage"
                            Source="/Assets/lamina1numerada.png"
                            Stretch="Uniform"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <!-- LÂMINA 2 -->
                        <Image
                            x:Name="Lamina2VisualImage"
                            Source="/Assets/lamina2numerada.png"
                            Stretch="Uniform"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <!-- LÂMINA 3 -->
                        <Image
                            x:Name="Lamina3VisualImage"
                            Source="/Assets/lamina3numerada.png"
                            Stretch="Uniform"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <!-- LÂMINA 4 -->
                        <Image
                            x:Name="Lamina4VisualImage"
                            Source="/Assets/lamina4numerada.png"
                            Stretch="Uniform"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <!-- LÂMINA 5 -->
                        <Image
                            x:Name="Lamina5VisualImage"
                            Source="/Assets/lamina5numerada.png"
                            Stretch="Uniform"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Grid>


                    <!-- ============================================= -->
                    <!-- BOTÕES DOS POÇOS                             -->
                    <!-- C# DEFINE COLUNA E LINHA                      -->
                    <!-- ============================================= -->

                    <Button
                        x:Name="Poco1Button"
                        Content="1"
                        Classes="pocoButton"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="Poco1_Click"/>


                    <Button
                        x:Name="Poco2Button"
                        Content="2"
                        Classes="pocoButton"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="Poco2_Click"/>


                    <Button
                        x:Name="Poco3Button"
                        Content="3"
                        Classes="pocoButton"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="Poco3_Click"/>


                    <Button
                        x:Name="Poco4Button"
                        Content="4"
                        Classes="pocoButton"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="Poco4_Click"/>


                    <Button
                        x:Name="Poco5Button"
                        Content="5"
                        Classes="pocoButton"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="Poco5_Click"/>

                </Grid>

            </Grid>


            <!-- ================================================= -->
            <!-- LINHA EXATAMENTE NO CENTRO                       -->
            <!-- ================================================= -->

            <Border
                Grid.Column="1"
                Width="1"
                Background="#D9D2E4"
                Margin="0,5,0,5"/>


            <!-- ================================================= -->
            <!-- QUADRANTE - DIREITA                              -->
            <!-- ================================================= -->

            <Grid
                Grid.Column="2"
                Margin="24,0,0,0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- TÍTULO -->

                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Spacing="4">

                    <TextBlock
                        Text="QUADRANTE"
                        FontSize="34"
                        FontWeight="Bold"
                        Foreground="#644899"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="Selecione o quadrante do poço"
                        FontSize="15"
                        Foreground="#6E667A"
                        HorizontalAlignment="Center"/>

                    <Border
                        Width="58"
                        Height="4"
                        CornerRadius="2"
                        Background="#D83D94"
                        HorizontalAlignment="Center"
                        Margin="0,7,0,0"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- QUADRANTES                                       -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="1"
                    Width="400"
                    Height="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">


                    <!-- Q2 -->

                    <Button
                        x:Name="Quadrante2Button"
                        Content="Q2&#x0a;•••&#x0a;•••&#x0a;•••"
                        Classes="quadranteButton"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12,45,0,0"
                        Click="Quadrante2_Click"/>


                    <!-- Q1 -->

                    <Button
                        x:Name="Quadrante1Button"
                        Content="Q1&#x0a;•••&#x0a;•••&#x0a;•••"
                        Classes="quadranteButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,45,12,0"
                        Click="Quadrante1_Click"/>


                    <!-- ========================================= -->
                    <!-- DESENHO CENTRAL                          -->
                    <!-- ========================================= -->

<!-- ========================================= -->
<!-- IMAGEM REAL DO QUADRANTE                 -->
<!-- ========================================= -->

    

                        <Image
                            Source="/Assets/quadrante.png"
                            Width="215"
                            Height="215"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

            


                    <!-- Q3 -->

                    <Button
                        x:Name="Quadrante3Button"
                        Content="Q3&#x0a;•••&#x0a;•••&#x0a;•••"
                        Classes="quadranteButton"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="12,0,0,45"
                        Click="Quadrante3_Click"/>


                    <!-- Q4 -->

                    <Button
                        x:Name="Quadrante4Button"
                        Content="Q4&#x0a;•••&#x0a;•••&#x0a;•••"
                        Classes="quadranteButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,12,45"
                        Click="Quadrante4_Click"/>

                </Grid>


                <!-- ================================================= -->
                <!-- AVANÇAR                                          -->
                <!-- ================================================= -->

                <Button
                    x:Name="AvancarButton"
                    Grid.Row="2"
                    Content="AVANÇAR    →"
                    Classes="avancarButton"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0"
                    IsEnabled="False"
                    Click="Avancar_Click"/>


                <!-- ================================================= -->
                <!-- BLOQUEIO DO LADO DIREITO                         -->
                <!-- ================================================= -->

                <Border
                    x:Name="QuadranteBloqueioOverlay"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Background="#EDEBED"
                    Opacity="0.96"
                    CornerRadius="16">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">

                        <Border
                            Width="62"
                            Height="62"
                            CornerRadius="31"
                            Background="#D4D1D7"
                            HorizontalAlignment="Center">

                            <TextBlock
                                Text="🔒"
                                FontSize="27"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <TextBlock
                            Text="QUADRANTE BLOQUEADO"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#66616F"
                            HorizontalAlignment="Center"/>


                        <TextBlock
                            Text="Selecione um poço para liberar os quadrantes."
                            FontSize="13"
                            Foreground="#77727F"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="280"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>