<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>


  <!-- ============================================================
       RECURSOS DO APLICATIVO
       ============================================================ -->

  <ItemGroup>

    <Folder Include="Models\" />

    <AvaloniaResource Include="Assets\**" />

  </ItemGroup>


  <!-- ============================================================
       PACOTES
       ============================================================ -->

  <ItemGroup>

    <PackageReference Include="Avalonia" Version="12.1.1" />

    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />

    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />

    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />

    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">
        None
      </IncludeAssets>

      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">
        All
      </PrivateAssets>
    </PackageReference>

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <PackageReference Include="QuestPDF" Version="2026.7.3" />

    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

  </ItemGroup>


  <!-- ============================================================
       TROVO - LINUX
       ============================================================ -->

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">

    <None Include="..\..\processing\linux\process_image"
          Link="processing\linux\process_image"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />

  </ItemGroup>


  <!-- ============================================================
       TROVO - WINDOWS
       ============================================================ -->

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">

    <None Include="..\..\processing\windows\process_image.exe"
          Link="processing\windows\process_image.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />

  </ItemGroup>


  <!-- ============================================================
       TROVO - MACOS
       ============================================================ -->

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">

    <None Include="..\..\processing\macos\process_image"
          Link="processing\macos\process_image"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />

  </ItemGroup>


  <!-- ============================================================
       GARANTE PERMISSÃO DE EXECUÇÃO NO LINUX
       ============================================================ -->

  <Target Name="TornarTrovoExecutavelLinux"
          AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">

    <Exec Command="chmod +x &quot;$(PublishDir)processing/linux/process_image&quot;" />

  </Target>


  <!-- ============================================================
       GARANTE PERMISSÃO DE EXECUÇÃO NO MACOS
       ============================================================ -->

  <Target Name="TornarTrovoExecutavelMacOS"
          AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">

    <Exec Command="chmod +x &quot;$(PublishDir)processing/macos/process_image&quot;" />

  </Target>

</Project>